---
interface Props {
  currentTab?: string;
}

const { currentTab } = Astro.props;
const base = import.meta.env.BASE_URL;

const tabs = [
  { id: "map", label: "Map", href: base },
  { id: "candidates", label: "Candidates", href: `${base}candidates` },
  { id: "guide", label: "Guide", href: `${base}guide` },
];
---

<header class="bg-votescot-dark text-votescot-paper border-b-[3px] border-votescot-gold px-4 pt-3.5 pb-3">
  <div class="max-w-[920px] mx-auto">
    <div class="flex items-center gap-2">
      <span class="text-lg">🏴󠁧󠁢󠁳󠁣󠁴󠁿</span>
      <div>
        <a href={base} class="no-underline text-inherit">
          <h1 class="text-lg font-heading font-black tracking-tight m-0">VoteScot</h1>
        </a>
        <div class="font-body text-xs text-votescot-gold tracking-widest uppercase font-bold">
          Scottish Parliament Election &bull; 7 May 2026
        </div>
      </div>
    </div>
  </div>
</header>

<nav class="max-w-[920px] mx-auto w-full px-3">
  <div class="flex gap-0 border-b-2 border-gray-300 mt-2 overflow-x-auto scrollbar-hide">
    {tabs.map((tab) => (
      <a
        href={tab.href}
        class:list={[
          "shrink-0 px-3.5 py-2 font-body text-xs font-medium uppercase tracking-wider -mb-[2px] no-underline",
          currentTab === tab.id
            ? "border-b-[3px] border-votescot-gold text-gray-900 font-bold"
            : "border-b-[3px] border-transparent text-gray-400 hover:text-gray-600",
        ]}
      >
        {tab.label}
      </a>
    ))}
  </div>
</nav>
