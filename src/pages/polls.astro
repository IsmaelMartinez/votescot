---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PollsChart from "../components/PollsChart.tsx";
import pollsData from "../../data/polls.json";

const latest = pollsData.constituency[0];
const recentPolls = pollsData.constituency.slice(0, 10);

const PARTY_LABELS: Record<string, string> = {
  snp: "SNP",
  con: "Con",
  lab: "Lab",
  libdem: "LD",
  green: "Green",
  alba: "Alba",
  reform: "Reform",
};

function formatDate(iso: string): string {
  return new Date(iso).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
}

type PartyKey = "snp" | "con" | "lab" | "libdem" | "green" | "alba" | "reform";

const PARTY_COLORS: Record<PartyKey, string> = {
  snp: "#9B870C",
  con: "#0087DC",
  lab: "#DC241F",
  libdem: "#FAA61A",
  green: "#00A651",
  alba: "#005EB8",
  reform: "#12B6CF",
};

const partyKeys = Object.keys(PARTY_LABELS) as PartyKey[];

// Sort latest poll parties for the headline bar
const sortedParties = partyKeys
  .filter((k) => latest[k] !== null && latest[k] !== undefined)
  .sort((a, b) => (latest[b] as number) - (latest[a] as number));
---

<Base title="Polling Trends" description="Latest opinion polling for the 2026 Scottish Parliament election">
  <Header slot="header" currentTab="polls" />

  <div class="py-3.5">
    <h2 class="font-heading text-base font-black mb-1">Polling Trends</h2>
    <p class="font-body text-[12.5px] text-gray-500 leading-snug mb-4">
      Opinion polling for the 2026 Scottish Parliament election. Updated daily from the Wikipedia polling tracker.
    </p>

    <!-- Latest poll headline bar -->
    <div class="bg-white border border-votescot-border rounded-md p-3 mb-4">
      <div class="font-body text-[10px] font-bold uppercase tracking-widest text-gray-400 mb-2">
        Latest Poll — {latest.pollster} · {formatDate(latest.endDate)}
        {latest.sampleSize ? ` · n=${latest.sampleSize.toLocaleString()}` : ""}
      </div>
      <div class="flex gap-1 flex-wrap">
        {sortedParties.map((key) => {
          const val = latest[key] as number;
          return (
            <div class="flex flex-col items-center">
              <div
                class="flex items-end justify-center font-body font-bold text-white text-[11px] rounded-sm"
                style={`background:${PARTY_COLORS[key]};width:${Math.max(val * 1.6, 24)}px;height:${Math.max(val * 1.4, 20)}px;`}
              >
                {val}%
              </div>
              <div class="font-body text-[9px] text-gray-500 mt-0.5 text-center">
                {PARTY_LABELS[key]}
              </div>
            </div>
          );
        })}
      </div>
    </div>

    <!-- Interactive line chart -->
    <div class="mb-4">
      <h3 class="font-body text-[13px] font-black text-gray-700 mb-2">Trends (Last 12 months)</h3>
      <PollsChart client:load data={pollsData} />
    </div>

    <!-- Recent polls table -->
    <div>
      <h3 class="font-body text-[13px] font-black text-gray-700 mb-2">Recent Polls (Constituency)</h3>
      <div class="overflow-x-auto">
        <table class="w-full font-body text-[11px] border-collapse">
          <thead>
            <tr class="border-b border-votescot-border">
              <th class="text-left py-1.5 pr-2 text-gray-400 font-medium">Date</th>
              <th class="text-left py-1.5 pr-2 text-gray-400 font-medium">Pollster</th>
              <th class="text-right py-1.5 pr-1 font-medium" style="color:#9B870C">SNP</th>
              <th class="text-right py-1.5 pr-1 font-medium" style="color:#DC241F">Lab</th>
              <th class="text-right py-1.5 pr-1 font-medium" style="color:#0087DC">Con</th>
              <th class="text-right py-1.5 pr-1 font-medium" style="color:#12B6CF">Ref</th>
              <th class="text-right py-1.5 pr-1 font-medium" style="color:#00A651">Grn</th>
              <th class="text-right py-1.5 pr-1 font-medium" style="color:#FAA61A">LD</th>
              <th class="text-right py-1.5 font-medium" style="color:#005EB8">Alba</th>
            </tr>
          </thead>
          <tbody>
            {recentPolls.map((poll, i) => (
              <tr class:list={["border-b border-gray-100", i % 2 === 0 ? "bg-white" : "bg-votescot-paper/40"]}>
                <td class="py-1.5 pr-2 text-gray-500 whitespace-nowrap">{formatDate(poll.endDate)}</td>
                <td class="py-1.5 pr-2 text-gray-700 whitespace-nowrap">{poll.pollster}</td>
                <td class="py-1.5 pr-1 text-right font-medium" style="color:#9B870C">{poll.snp !== null ? `${poll.snp}%` : "–"}</td>
                <td class="py-1.5 pr-1 text-right font-medium" style="color:#DC241F">{poll.lab !== null ? `${poll.lab}%` : "–"}</td>
                <td class="py-1.5 pr-1 text-right font-medium" style="color:#0087DC">{poll.con !== null ? `${poll.con}%` : "–"}</td>
                <td class="py-1.5 pr-1 text-right font-medium" style="color:#12B6CF">{poll.reform !== null ? `${poll.reform}%` : "–"}</td>
                <td class="py-1.5 pr-1 text-right font-medium" style="color:#00A651">{poll.green !== null ? `${poll.green}%` : "–"}</td>
                <td class="py-1.5 pr-1 text-right font-medium" style="color:#FAA61A">{poll.libdem !== null ? `${poll.libdem}%` : "–"}</td>
                <td class="py-1.5 text-right font-medium" style="color:#005EB8">{poll.alba !== null ? `${poll.alba}%` : "–"}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Attribution -->
    <p class="font-body text-[10px] text-gray-400 mt-3 leading-snug">
      Data from <a href="https://en.wikipedia.org/wiki/Opinion_polling_for_the_2026_Scottish_Parliament_election" target="_blank" rel="noopener" class="underline">Wikipedia polling tracker</a>.
      Polls conducted by BPC-registered polling firms.
      Last synced: {new Date(pollsData.lastUpdated).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" })}.
    </p>
  </div>

  <Footer slot="footer" />
</Base>
