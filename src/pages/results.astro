---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import {
  loadElectionState,
  loadConstituencies,
  loadConstituencyResults,
  loadRegionalResults,
  loadAccuracyReport,
} from "../lib/data";
import { PARTY_THEMES_BY_LONG, PARTY_THEMES_BY_SHORT, PARTY_COLORS_BY_SHORT } from "../lib/party-config";
import { partyKey } from "../lib/accuracy";
import pollsData from "../../data/polls.json";
import { rollingAverage, rangeOverWindow, type PollEntry, type PartyKey } from "../lib/poll-average";

const state = loadElectionState();
const constituencies = loadConstituencies();
const constituencyResults = Array.from(loadConstituencyResults().values());
const regionalResults = Array.from(loadRegionalResults().values());
const report = loadAccuracyReport();

const POLL_WINDOW = 10;
const constituencyPolls = (pollsData.constituency || []) as PollEntry[];
const { shares: pollAvgShares, pollsUsed: pollWindow } = rollingAverage(
  constituencyPolls,
  POLL_WINDOW,
);
const { ranges: pollRanges } = rangeOverWindow(constituencyPolls, POLL_WINDOW);

const declaredCount = constituencyResults.filter((r) => r.status === "declared").length;
const regionsDeclared = regionalResults.filter((r) => r.status === "declared").length;
const totalConstituencies = constituencyResults.length;
const totalRegions = regionalResults.length;

const phaseCopy: Record<string, string> = {
  "forecast": "Forecast period — polls have not yet opened.",
  "polls-open": "Polls are open. Results begin overnight after polls close.",
  "counting": "Polls have closed. Counting under way; first declarations expected soon.",
  "partial": `${declaredCount} of ${totalConstituencies} constituencies declared, ${regionsDeclared} of ${totalRegions} regions declared.`,
  "final": `All ${totalConstituencies} constituencies and ${totalRegions} regions declared.`,
};

const constituencyById = new Map(constituencies.map((c) => [c.id, c]));

const declared = constituencyResults
  .filter((r) => r.status === "declared")
  .sort((a, b) => (a.declaredAt ?? "").localeCompare(b.declaredAt ?? ""))
  .map((r) => ({
    ...r,
    name: constituencyById.get(r.id)?.name ?? r.id,
    region: constituencyById.get(r.id)?.region ?? "",
    competitiveness: constituencyById.get(r.id)?.competitiveness,
    forecast: constituencyById.get(r.id)?.projection,
  }));

const surprises = declared.filter((r) => {
  if (!r.forecast || !r.winner) return false;
  const f = partyKey(r.forecast);
  const w = partyKey(r.winner);
  return f != null && w != null && f !== w;
});

function partyLabel(p: string): string {
  return PARTY_THEMES_BY_LONG[p]?.label ?? PARTY_THEMES_BY_SHORT[p]?.label ?? p;
}

function partyColor(p: string): string {
  return PARTY_THEMES_BY_LONG[p]?.color ?? PARTY_COLORS_BY_SHORT[p] ?? "#cbd5e1";
}

const pollsters = report?.pollsters ?? [];
const constituencyPollsterScores = pollsters.filter((p: any) => p.ballot === "constituency");
const regionalPollsterScores = pollsters.filter((p: any) => p.ballot === "regional");

// Some pollsters are co-published under joint bylines but score the same data.
const POLLSTER_ALIASES: Record<string, string> = {
  "Find Out Now / Electoral Calculus": "Find Out Now",
};

function canonicalPollster(name: string): string {
  return POLLSTER_ALIASES[name] ?? name;
}

// Best-by-pollster summary: average MAE across each pollster's last week, ballot-aware.
function bestByPollster(scores: any[]): { pollster: string; mae: number; rmse: number; n: number }[] {
  const bucket = new Map<string, { sumMae: number; sumRmse: number; n: number }>();
  for (const s of scores) {
    const key = canonicalPollster(s.pollster);
    const cur = bucket.get(key) ?? { sumMae: 0, sumRmse: 0, n: 0 };
    cur.sumMae += s.mae;
    cur.sumRmse += s.rmse;
    cur.n += 1;
    bucket.set(key, cur);
  }
  return Array.from(bucket, ([pollster, v]) => ({
    pollster,
    mae: v.sumMae / v.n,
    rmse: v.sumRmse / v.n,
    n: v.n,
  })).sort((a, b) => a.mae - b.mae);
}

const constituencyLeague = bestByPollster(constituencyPollsterScores);
const regionalLeague = bestByPollster(regionalPollsterScores);
const mrps = report?.mrps ?? [];
const projection = report?.votescotProjection ?? null;

const showResults = state.phase === "partial" || state.phase === "final";

// Pre-election VoteScot constituency-seat forecast: sum each party's
// projected wins across the 73 constituencies. Regional list is excluded
// because we don't carry a regional pre-election forecast in YAML.
const forecastConstituencySeats: Record<string, number> = {};
for (const c of constituencies) {
  const key = c.projection ? partyKey(c.projection) : null;
  if (!key) continue;
  forecastConstituencySeats[key] = (forecastConstituencySeats[key] ?? 0) + 1;
}

const HEADLINE_PARTY_ORDER: string[] = ["snp", "lab", "reform", "con", "libdem", "green"];

const headlineRows = HEADLINE_PARTY_ORDER
  .map((party) => {
    const actualShare = (report?.national?.constituency?.[party] as number | undefined) ?? 0;
    const pollShare = pollAvgShares[party as PartyKey] ?? 0;
    const actualSeats = (report?.seatTotals?.[party] as number | undefined) ?? 0;
    const forecastSeats = forecastConstituencySeats[party] ?? 0;
    return { party, actualShare, pollShare, actualSeats, forecastSeats };
  })
  .filter((r) => r.actualShare > 0 || r.pollShare > 0 || r.actualSeats > 0 || r.forecastSeats > 0);

const maxShareForRow = Math.max(
  1,
  ...headlineRows.map((r) => Math.max(r.actualShare, r.pollShare)),
);
const maxSeatsForRow = Math.max(
  1,
  ...headlineRows.map((r) => Math.max(r.actualSeats, r.forecastSeats)),
);
const totalActualSeats = headlineRows.reduce((s, r) => s + r.actualSeats, 0);

// Forecast misses → flow data. Each surprise has forecast party + actual party.
// Build per-(forecast,actual) counts, plus per-side totals for stacking.
type FlowKey = string; // `${forecast}>${actual}`
const flowCounts = new Map<FlowKey, number>();
const forecastTotals = new Map<string, number>();
const actualTotals = new Map<string, number>();
for (const s of surprises) {
  const f = partyKey(s.forecast!);
  const a = partyKey(s.winner!);
  if (!f || !a) continue;
  const key = `${f}>${a}`;
  flowCounts.set(key, (flowCounts.get(key) ?? 0) + 1);
  forecastTotals.set(f, (forecastTotals.get(f) ?? 0) + 1);
  actualTotals.set(a, (actualTotals.get(a) ?? 0) + 1);
}

const sankey = (() => {
  const totalMisses = surprises.length;
  if (totalMisses === 0) return null;
  const W = 360;
  const H = Math.max(160, totalMisses * 14);
  const COL_W = 80;
  const GAP_PX = 4;

  function buildColumn(totals: Map<string, number>): { party: string; total: number; y0: number; y1: number }[] {
    const entries = Array.from(totals.entries()).sort((a, b) => b[1] - a[1]);
    const sumGap = Math.max(0, (entries.length - 1) * GAP_PX);
    const flowH = H - sumGap;
    let y = 0;
    return entries.map(([party, total]) => {
      const h = (total / totalMisses) * flowH;
      const r = { party, total, y0: y, y1: y + h };
      y = r.y1 + GAP_PX;
      return r;
    });
  }

  const left = buildColumn(forecastTotals);
  const right = buildColumn(actualTotals);
  const leftIdx = new Map(left.map((b) => [b.party, b]));
  const rightIdx = new Map(right.map((b) => [b.party, b]));

  // Walk transitions in display order (forecast top → bottom, then within each
  // forecast bucket, by destination ranking). Each transition consumes a slice
  // off the top of both src and dst remaining heights.
  const leftCursor = new Map(left.map((b) => [b.party, b.y0]));
  const rightCursor = new Map(right.map((b) => [b.party, b.y0]));

  type Ribbon = { from: string; to: string; count: number; ly0: number; ly1: number; ry0: number; ry1: number };
  const ribbons: Ribbon[] = [];
  for (const lb of left) {
    const fromParty = lb.party;
    const transitions = Array.from(flowCounts.entries())
      .filter(([key]) => key.startsWith(`${fromParty}>`))
      .map(([key, count]) => ({ to: key.split(">")[1], count }))
      .sort((a, b) => (rightIdx.get(a.to)?.y0 ?? 0) - (rightIdx.get(b.to)?.y0 ?? 0));
    for (const t of transitions) {
      const lY = leftCursor.get(fromParty) ?? lb.y0;
      const rY = rightCursor.get(t.to) ?? 0;
      const sumGap = Math.max(0, (left.length - 1) * GAP_PX);
      const flowH = H - sumGap;
      const slice = (t.count / totalMisses) * flowH;
      ribbons.push({
        from: fromParty,
        to: t.to,
        count: t.count,
        ly0: lY,
        ly1: lY + slice,
        ry0: rY,
        ry1: rY + slice,
      });
      leftCursor.set(fromParty, lY + slice);
      rightCursor.set(t.to, rY + slice);
    }
  }

  return { W, H, COL_W, left, right, ribbons };
})();
---

<Base
  title="Results & Forecast Accuracy"
  description="Live results from the 2026 Scottish Parliament election and how the polls compared."
>
  <Header slot="header" currentTab="results" />

  <div class="py-6">
    <h2 class="font-heading text-2xl font-black mb-2">Results & accuracy</h2>
    <p class="font-body text-sm text-gray-600 leading-relaxed mb-4">
      {phaseCopy[state.phase] ?? phaseCopy["polls-open"]}
      {state.lastUpdated && (
        <span class="block text-xs text-gray-400 mt-1">
          Last updated {new Date(state.lastUpdated).toLocaleString("en-GB")}
        </span>
      )}
    </p>

    {!showResults && (
      <div class="bg-votescot-dark text-votescot-paper rounded-lg p-4 mb-6">
        <h3 class="font-heading text-base font-bold mb-1">Results pending</h3>
        <p class="font-body text-xs leading-relaxed">
          This page will populate once results begin to declare. Until then,
          browse the
          <a href="/" class="text-votescot-gold underline">forecast map</a>
          or read the
          <a href="/guide" class="text-votescot-gold underline">polling overview</a>.
        </p>
      </div>
    )}

    {showResults && headlineRows.length > 0 && (
      <section class="mb-6 bg-white border border-votescot-border rounded-lg p-4">
        <h3 class="font-heading text-base font-bold mb-1">Results vs forecast</h3>
        <p class="font-body text-xs text-gray-500 mb-3">
          Each row: actual share and seats compared with the polling average ({pollWindow.length} polls) and the VoteScot pre-election forecast (constituency only).
        </p>
        <div class="grid grid-cols-[2.75rem_1fr_4rem_1fr_3.25rem] gap-2 items-center mb-2 font-body text-[10px] uppercase tracking-wider text-gray-400">
          <div></div>
          <div>Vote share</div>
          <div class="text-right">%</div>
          <div>Seats</div>
          <div class="text-right">N</div>
        </div>
        <div class="flex flex-col gap-2">
          {headlineRows.map(({ party, actualShare, pollShare, actualSeats, forecastSeats }) => {
            const actualSharePct = (actualShare / maxShareForRow) * 100;
            const pollSharePct = (pollShare / maxShareForRow) * 100;
            const actualSeatsPct = (actualSeats / maxSeatsForRow) * 100;
            const forecastSeatsPct = (forecastSeats / maxSeatsForRow) * 100;
            const seatDelta = actualSeats - forecastSeats;
            const colour = PARTY_COLORS_BY_SHORT[party] ?? "#94a3b8";
            return (
              <div class="grid grid-cols-[2.75rem_1fr_4rem_1fr_3.25rem] gap-2 items-center">
                <div class="font-body text-xs font-bold uppercase tracking-wider text-gray-700 text-right">
                  {partyLabel(party)}
                </div>
                <div class="flex flex-col gap-0.5">
                  <div class="h-3 bg-gray-50 rounded-sm overflow-hidden">
                    <div class="h-full rounded-sm" style={`width:${actualSharePct}%;background:${colour}`} />
                  </div>
                  <div class="h-2 bg-gray-50 rounded-sm overflow-hidden">
                    <div class="h-full bg-gray-300 rounded-sm" style={`width:${pollSharePct}%`} />
                  </div>
                </div>
                <div class="text-right font-mono text-[11px] leading-tight">
                  <div class="font-bold text-gray-800">{actualShare.toFixed(1)}</div>
                  <div class="text-gray-400">{pollShare.toFixed(1)}</div>
                </div>
                <div class="flex flex-col gap-0.5">
                  <div class="h-3 bg-gray-50 rounded-sm overflow-hidden">
                    <div class="h-full rounded-sm" style={`width:${actualSeatsPct}%;background:${colour}`} />
                  </div>
                  <div class="h-2 bg-gray-50 rounded-sm overflow-hidden">
                    <div class="h-full bg-gray-300 rounded-sm" style={`width:${forecastSeatsPct}%`} />
                  </div>
                </div>
                <div class="text-right font-mono text-[11px] leading-tight">
                  <div class="font-bold text-gray-800">{actualSeats}</div>
                  <div class="text-gray-400">{forecastSeats}</div>
                  {forecastSeats > 0 && (
                    <div class={`text-[10px] ${seatDelta >= 0 ? "text-emerald-600" : "text-rose-600"}`}>
                      {seatDelta >= 0 ? "+" : ""}{seatDelta}
                    </div>
                  )}
                </div>
              </div>
            );
          })}
        </div>
        <div class="flex flex-wrap items-center gap-3 mt-3 font-body text-[11px] text-gray-500">
          <span class="flex items-center gap-1.5"><span class="inline-block w-3 h-2.5 rounded-sm bg-votescot-dark" /> Actual</span>
          <span class="flex items-center gap-1.5"><span class="inline-block w-3 h-2 rounded-sm bg-gray-300" /> Polling avg / pre-election forecast</span>
          <span class="text-gray-400 ml-auto">{totalActualSeats} of 129 seats declared · 65 for majority</span>
        </div>
      </section>
    )}

    {showResults && projection && projection.totalSeats > 0 && (
      <section class="mb-6 bg-white border border-votescot-border rounded-lg p-4">
        <h3 class="font-heading text-base font-bold mb-1">VoteScot's per-seat hit rate</h3>
        <p class="font-body text-xs text-gray-500 mb-3">
          How often the pre-election projection picked the actual winner, across {projection.totalSeats} declared constituency seats.
        </p>
        <div class="flex items-baseline gap-2 mb-3">
          <div class="font-heading text-3xl font-black">{(projection.hitRate * 100).toFixed(1)}%</div>
          <div class="font-body text-sm text-gray-500">{projection.correctWinners} of {projection.totalSeats}</div>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs">
          {(["safe", "competitive", "marginal", "toss-up"] as const).map((bucket) => {
            const stats = projection.byCompetitiveness?.[bucket] as
              | { total: number; correct: number; hitRate: number }
              | undefined;
            if (!stats) return null;
            return (
              <div class="bg-gray-50 rounded p-2">
                <div class="font-body font-bold uppercase tracking-wider text-gray-500">{bucket}</div>
                <div class="font-heading text-base font-black">{(stats.hitRate * 100).toFixed(0)}%</div>
                <div class="text-gray-400">{stats.correct}/{stats.total}</div>
              </div>
            );
          })}
        </div>
        <p class="font-body text-xs text-gray-500 mt-3">
          Mean absolute error on top-three party shares: <strong>{projection.shareMae?.toFixed(1) ?? "—"}</strong> percentage points.
        </p>
      </section>
    )}

    {showResults && (constituencyLeague.length > 0 || regionalLeague.length > 0) && (() => {
      const maxMae = Math.max(
        1,
        ...constituencyLeague.map((r) => r.mae),
        ...regionalLeague.map((r) => r.mae),
      );
      const renderLeague = (rows: { pollster: string; mae: number; rmse: number; n: number }[]) =>
        rows.map((row, i) => {
          const widthPct = (row.mae / maxMae) * 100;
          const rmsePct = Math.min(100, (row.rmse / maxMae) * 100);
          return (
            <div class="grid grid-cols-[1.25rem_1fr_3.5rem] gap-2 items-center text-xs py-0.5">
              <div class="font-body font-bold text-gray-400 text-right">{i + 1}</div>
              <div class="flex flex-col gap-0.5">
                <div class="font-body font-bold text-gray-700 leading-tight">{row.pollster}</div>
                <div class="relative h-2.5 bg-gray-50 rounded-sm overflow-hidden">
                  <div class="h-full rounded-sm bg-votescot-dark" style={`width:${widthPct}%`} title={`MAE ${row.mae.toFixed(2)}`} />
                  <div class="absolute top-0 bottom-0 w-px bg-rose-500" style={`left:${rmsePct}%`} title={`RMSE ${row.rmse.toFixed(2)}`} />
                </div>
              </div>
              <div class="text-right font-mono text-[11px] text-gray-500 leading-tight">
                <div>{row.mae.toFixed(2)}</div>
                <div class="text-gray-400">n={row.n}</div>
              </div>
            </div>
          );
        });
      return (
        <details class="mb-3 bg-white border border-votescot-border rounded-lg p-3">
          <summary class="cursor-pointer font-body text-sm font-bold text-gray-700">
            Pollster accuracy ({constituencyLeague.length + regionalLeague.length} entries)
          </summary>
          <p class="font-body text-xs text-gray-500 mt-3 mb-2">
            Mean absolute error in percentage points (lower is better). Bar = MAE; thin red tick = RMSE.
          </p>
          {constituencyLeague.length > 0 && (
            <>
              <h4 class="font-body text-[11px] font-bold uppercase tracking-wider text-gray-500 mt-3 mb-1.5">Constituency vote</h4>
              <div>{renderLeague(constituencyLeague)}</div>
            </>
          )}
          {regionalLeague.length > 0 && (
            <>
              <h4 class="font-body text-[11px] font-bold uppercase tracking-wider text-gray-500 mt-3 mb-1.5">Regional list vote</h4>
              <div>{renderLeague(regionalLeague)}</div>
            </>
          )}
          <details class="mt-3 text-xs text-gray-600">
            <summary class="cursor-pointer font-body font-bold text-votescot-gold hover:underline">What do MAE and RMSE mean?</summary>
            <div class="mt-2 leading-relaxed font-body">
              <p class="mb-1.5"><strong>MAE</strong> is the average gap, in percentage points, between predicted and actual party shares.</p>
              <p><strong>RMSE</strong> punishes big errors more heavily than small ones, so a pollster with one giant miss scores worse on RMSE than on MAE.</p>
            </div>
          </details>
        </details>
      );
    })()}

    {showResults && mrps.length > 0 && (
      <details class="mb-3 bg-white border border-votescot-border rounded-lg p-3">
        <summary class="cursor-pointer font-body text-sm font-bold text-gray-700">
          MRP seat forecasts vs actual ({mrps.length})
        </summary>
        <p class="font-body text-xs text-gray-500 mt-3 mb-2">
          MRPs are the only public forecasts that give per-seat predictions. Total seat error sums |predicted − actual| across all parties.
        </p>
        <table class="w-full text-sm">
          <thead>
            <tr class="text-left text-xs text-gray-400 uppercase tracking-wider">
              <th class="py-1.5">Rank</th>
              <th>Pollster</th>
              <th>Client</th>
              <th class="text-right">Total error</th>
              <th class="text-right">Per-party MAE</th>
            </tr>
          </thead>
          <tbody>
            {mrps.map((m: any, i: number) => (
              <tr class="border-t border-votescot-border">
                <td class="py-1.5 font-body font-bold text-gray-400">{i + 1}</td>
                <td class="font-body font-bold">{m.pollster}</td>
                <td class="text-gray-500 text-xs">{m.client}</td>
                <td class="text-right font-mono">{m.totalSeatError}</td>
                <td class="text-right font-mono text-gray-500">{m.seatMae.toFixed(2)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </details>
    )}

    {showResults && sankey && (
      <section class="mb-6 bg-white border border-votescot-border rounded-lg p-4">
        <h3 class="font-heading text-base font-bold mb-1">Forecast misses ({surprises.length})</h3>
        <p class="font-body text-xs text-gray-500 mb-3">
          Where the seats VoteScot forecast incorrectly ended up. Left column = predicted winner; right column = actual winner; ribbon thickness = number of seats.
        </p>
        <div class="overflow-x-auto">
          <svg viewBox={`0 0 ${sankey.W} ${sankey.H + 20}`} width="100%" preserveAspectRatio="xMinYMin meet" role="img" aria-label="Forecast vs actual seat flow">
            <g transform="translate(0,10)">
              {sankey.ribbons.map((r) => {
                const x1 = sankey.COL_W;
                const x2 = sankey.W - sankey.COL_W;
                const cx = (x1 + x2) / 2;
                const d = `M ${x1},${r.ly0} C ${cx},${r.ly0} ${cx},${r.ry0} ${x2},${r.ry0} L ${x2},${r.ry1} C ${cx},${r.ry1} ${cx},${r.ly1} ${x1},${r.ly1} Z`;
                return (
                  <path
                    d={d}
                    fill={partyColor(r.from)}
                    fill-opacity="0.35"
                    stroke={partyColor(r.from)}
                    stroke-opacity="0.5"
                    stroke-width="0.5"
                  >
                    <title>{`${partyLabel(r.from)} → ${partyLabel(r.to)}: ${r.count} seat${r.count === 1 ? "" : "s"}`}</title>
                  </path>
                );
              })}
              {sankey.left.map((b) => (
                <>
                  <rect x="0" y={b.y0} width={sankey.COL_W - 4} height={Math.max(2, b.y1 - b.y0)} fill={partyColor(b.party)} rx="2" />
                  <text x={sankey.COL_W - 8} y={(b.y0 + b.y1) / 2 + 3} text-anchor="end" font-size="10" font-family="ui-sans-serif" fill="#fff" font-weight="700">
                    {partyLabel(b.party)} {b.total}
                  </text>
                </>
              ))}
              {sankey.right.map((b) => (
                <>
                  <rect x={sankey.W - sankey.COL_W + 4} y={b.y0} width={sankey.COL_W - 4} height={Math.max(2, b.y1 - b.y0)} fill={partyColor(b.party)} rx="2" />
                  <text x={sankey.W - sankey.COL_W + 8} y={(b.y0 + b.y1) / 2 + 3} text-anchor="start" font-size="10" font-family="ui-sans-serif" fill="#fff" font-weight="700">
                    {partyLabel(b.party)} {b.total}
                  </text>
                </>
              ))}
            </g>
          </svg>
        </div>
        <div class="flex justify-between font-body text-[10px] uppercase tracking-wider text-gray-400 mt-1">
          <span>Forecast</span>
          <span>Actual</span>
        </div>
        <details class="mt-3 text-xs text-gray-600">
          <summary class="cursor-pointer font-body font-bold text-votescot-gold hover:underline">List of seats</summary>
          <ul class="flex flex-col gap-1.5 mt-2">
            {surprises.map((s) => (
              <li class="flex items-center justify-between bg-gray-50 rounded p-2 text-sm">
                <a href={`/candidates/constituency/${s.id}`} class="font-body font-bold no-underline text-gray-900 hover:text-votescot-gold">{s.name}</a>
                <span class="text-xs">
                  <span class="font-bold" style={`color: ${partyColor(s.forecast!)}`}>{partyLabel(s.forecast!)}</span>
                  <span class="text-gray-400 mx-2">→</span>
                  <span class="font-bold" style={`color: ${partyColor(s.winner!)}`}>{partyLabel(s.winner!)}</span>
                </span>
              </li>
            ))}
          </ul>
        </details>
      </section>
    )}
  </div>

  <Footer slot="footer" />
</Base>
