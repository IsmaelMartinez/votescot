---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ConstituencyMap from "../components/ConstituencyMap.tsx";
import NewsList from "../components/NewsList.astro";
import { loadConstituencies, loadNews } from "../lib/data";

const constituencies = loadConstituencies();
const knownConstituencies = constituencies.map((c) => c.id);
const base = import.meta.env.BASE_URL;

const projections = constituencies
  .filter((c) => c.projection)
  .map((c) => ({
    id: c.id,
    projection: c.projection,
    competitiveness: c.competitiveness,
    topParties: c.topParties,
  }));

const news = loadNews();
---

<Base title="VoteScot — 2026 Scottish Parliament Election">
  <Header slot="header" currentTab="map" />

  <div class="py-6">
    <h2 class="font-heading text-2xl font-black mb-2">Navigate the noise</h2>
    <p class="font-body text-sm text-gray-600 leading-relaxed mb-4">
      Scotland votes on 7 May 2026. Find your constituency, discover which
      candidates align with your values, and access the research you need to make an informed choice.
    </p>

    <ConstituencyMap
      client:only="react"
      knownConstituencies={knownConstituencies}
      basePath={base}
      projections={projections}
    />

    <NewsList
      items={news.items}
      sources={news.sources}
      limit={5}
    />

    <div class="mt-6 p-3 bg-votescot-dark rounded-lg font-body text-xs text-gray-300 leading-relaxed text-center">
      <strong class="text-votescot-gold">Privacy-first:</strong> The quiz runs entirely in your browser.
      No cookies, analytics, or accounts. The map loads tiles from OpenStreetMap, and postcode lookups query MapIt.
    </div>
  </div>

  <Footer slot="footer" />
</Base>
