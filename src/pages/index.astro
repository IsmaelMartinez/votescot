---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ConstituencyMap from "../components/ConstituencyMap.tsx";
import NewsList from "../components/NewsList.astro";
import {
  loadConstituencies,
  loadNews,
  loadRegions,
  loadRegionalCandidatesByRegion,
  loadConstituencyResults,
  loadElectionState,
} from "../lib/data";
import { slugifyConstituency } from "../lib/slugify";

const constituencies = loadConstituencies();
const knownConstituencies = constituencies.map((c) => c.id);
const base = import.meta.env.BASE_URL;

const state = loadElectionState();
const showForecastOverride = Astro.url.searchParams.get("view") === "forecast";
const useResults = !showForecastOverride && (state.phase === "partial" || state.phase === "final");
const results = useResults ? loadConstituencyResults() : null;

// When results are available, recolor the map by actual winner. Pending
// constituencies fall back to the forecast so the map keeps coverage.
const projections = constituencies.map((c) => {
  const r = results?.get(c.id);
  if (r?.status === "declared" && r.winner) {
    const top = [...(r.results ?? [])]
      .sort((a, b) => (b.share ?? 0) - (a.share ?? 0))
      .slice(0, 3)
      .map((entry) => ({
        party: entry.party,
        share: Number((entry.share ?? 0).toFixed(1)),
        status: "will-win" as const,
      }));
    return {
      id: c.id,
      projection: r.winner,
      competitiveness: "safe" as const,
      topParties: top,
      isResult: true,
    };
  }
  if (c.projection) {
    return {
      id: c.id,
      projection: c.projection,
      competitiveness: c.competitiveness,
      topParties: c.topParties,
    };
  }
  return null;
}).filter((p): p is NonNullable<typeof p> => p !== null);

const declaredCount = results
  ? Array.from(results.values()).filter((r) => r.status === "declared").length
  : 0;

const baseRegions = loadRegions();
const mapRegions = baseRegions.map((r) => ({ id: r.id, name: r.name }));
const constituencyRegions: Record<string, string> = Object.fromEntries(
  constituencies
    .filter((c) => c.region?.trim())
    .map((c) => [c.id, slugifyConstituency(c.region.trim())])
);

const regions = baseRegions.map((r) => ({
  ...r,
  constituencyCount: constituencies.filter((c) => c.region?.trim() === r.name).length,
  candidateCount: loadRegionalCandidatesByRegion(r.id).length,
}));

const news = loadNews();
---

<Base title="VoteScot · 2026 Scottish Parliament Election">
  <Header slot="header" currentTab="map" />

  <div class="py-6">
    <h2 class="font-heading text-2xl font-black mb-2">
      {useResults ? "Live results" : "Navigate the noise"}
    </h2>
    <p class="font-body text-sm text-gray-600 leading-relaxed mb-4">
      {useResults ? (
        <>
          {declaredCount} of {constituencies.length} constituencies declared.
          Map shows actual winners (declared) and forecasts (pending).
          {" "}
          <a href="/results" class="text-votescot-gold underline">See pollster accuracy →</a>
          {" · "}
          <a href="?view=forecast" class="text-gray-500 underline">Show pre-election forecast</a>
        </>
      ) : (
        <>Scotland votes on 7 May 2026. Find your constituency, discover which candidates align with your values, and access the research you need to make an informed choice.</>
      )}
    </p>

    <ConstituencyMap
      client:only="react"
      knownConstituencies={knownConstituencies}
      basePath={base}
      projections={projections}
      constituencyRegions={constituencyRegions}
      regions={mapRegions}
    />

    <section class="my-6">
      <h3 class="font-heading text-base font-black mb-1">Browse by region</h3>
      <p class="font-body text-xs text-gray-500 leading-snug mb-3">
        Scotland's regional list ballot is split into 8 regions. Pick yours to see every party's regional list candidates.
      </p>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
        {regions.map((r) => (
          <a
            href={`${base}candidates/region/${r.id}`}
            class="block bg-white border border-votescot-border rounded-lg px-3 py-2 no-underline hover:border-votescot-gold transition-colors"
          >
            <div class="font-heading text-sm font-bold text-votescot-dark leading-tight">{r.name}</div>
            <div class="font-body text-xs text-gray-500 leading-snug mt-0.5">
              {r.constituencyCount} constituencies · {r.candidateCount} list candidates
            </div>
          </a>
        ))}
      </div>
    </section>

    <NewsList
      items={news.items}
      sources={news.sources}
      limit={5}
    />

    <div class="mt-6 p-3 bg-votescot-dark rounded-lg font-body text-xs text-gray-300 leading-relaxed text-center">
      <strong class="text-votescot-gold">Privacy-first:</strong> The quiz runs entirely in your browser.
      No cookies, analytics, or accounts. The map loads tiles from OpenStreetMap, and postcode lookups query MapIt.
    </div>
  </div>

  <Footer slot="footer" />
</Base>
