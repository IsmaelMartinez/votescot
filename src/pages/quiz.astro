---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import QuizEngine from "../components/QuizEngine.tsx";
import { loadCandidates, loadQuestions, loadConstituencies } from "../lib/data";

const questions = loadQuestions();
const candidates = loadCandidates().filter((c) => c.quizCandidate);
const constituencies = loadConstituencies();
const base = import.meta.env.BASE_URL;
---

<Base title="Vote Compass" description="Answer 8 questions and find which candidate aligns with your values">
  <Header slot="header" currentTab="quiz" />
  <QuizEngine client:load mode="constituency" questions={questions} candidates={candidates} constituencies={constituencies} knownConstituencies={constituencies.map((c) => c.id)} basePath={base} />
  <Footer slot="footer" />
</Base>
