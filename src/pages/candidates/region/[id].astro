---
import Base from "../../../layouts/Base.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import CandidateCard from "../../../components/CandidateCard.astro";
import CandidateComparison from "../../../components/CandidateComparison.tsx";
import { loadCandidatesByRegion, loadConstituencies, loadQuestions, loadRegions } from "../../../lib/data";

export function getStaticPaths() {
  const regions = loadRegions();
  const constituencies = loadConstituencies();
  return regions.map((r) => {
    const candidates = loadCandidatesByRegion(r.name);
    const regionConstituencies = constituencies.filter((c) => c.region === r.name);
    return { params: { id: r.id }, props: { region: r, candidates, regionConstituencies } };
  });
}

const { region, candidates, regionConstituencies } = Astro.props;
const base = import.meta.env.BASE_URL;
const questions = loadQuestions();
const quizCandidates = candidates.filter((c: any) => c.quizCandidate);
const otherCandidates = candidates.filter((c: any) => !c.quizCandidate);
const comparisonConstituencies = regionConstituencies.map((c: any) => ({ id: c.id, name: c.name }));
---

<Base title={`${region.name} Candidates`} description={`Candidates standing in the ${region.name} region for the 2026 Scottish Parliament election`}>
  <Header slot="header" currentTab="candidates" />

  <div class="py-3.5">
    <div class="mb-4">
      <a href={`${base}candidates`} class="font-body text-xs text-gray-400 no-underline hover:text-gray-600">← All constituencies</a>
    </div>

    <h2 class="font-heading text-lg font-black mb-0.5">{region.name}</h2>
    <p class="font-body text-xs text-gray-400 leading-snug mb-1">
      Regional list ballot. Covers {regionConstituencies.length} constituencies: {regionConstituencies.map((c: any) => c.name).join(", ")}.
    </p>
    <p class="font-body text-[12.5px] text-gray-500 leading-snug mb-4">
      {candidates.length} candidates standing across this region for 7 May 2026.
    </p>

    <div class="mb-5 bg-blue-50 border border-blue-200 rounded px-3 py-2 font-body text-xs text-blue-700">
      Scottish Parliament uses two ballots — constituency and regional list. We don't yet model separate regional list candidates, so these are the constituency candidates standing inside the region.
    </div>

    {quizCandidates.length > 0 && (
      <div class="mb-4">
        <div class="font-body text-xs font-bold uppercase tracking-widest text-gray-400 mb-2">
          Quiz candidates — included in vote compass matching
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
          {quizCandidates.map((c: any) => (
            <CandidateCard candidate={c} basePath={base} />
          ))}
        </div>
      </div>
    )}

    {otherCandidates.length > 0 && (
      <div>
        <div class="font-body text-xs font-bold uppercase tracking-widest text-gray-400 mb-2">
          {quizCandidates.length > 0 ? "Other candidates" : "Candidates"}
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
          {otherCandidates.map((c: any) => (
            <CandidateCard candidate={c} basePath={base} />
          ))}
        </div>
      </div>
    )}

    {quizCandidates.length > 1 && (
      <details class="mt-5 mb-6 bg-white border border-votescot-border rounded-lg">
        <summary class="px-4 py-3 cursor-pointer font-heading font-bold text-sm hover:text-votescot-gold transition-colors">
          Compare candidates side by side
        </summary>
        <div class="px-4 pb-4">
          <CandidateComparison client:visible candidates={quizCandidates} questions={questions} constituencies={comparisonConstituencies} />
        </div>
      </details>
    )}

    <div class="mt-6 text-center">
      <a href={`${base}quiz/regional?region=${region.id}`} class="inline-block px-4 py-2 bg-votescot-gold text-white rounded-lg font-body text-sm font-bold no-underline hover:opacity-90">
        Take the regional vote compass for {region.name} →
      </a>
    </div>
  </div>

  <Footer slot="footer" />
</Base>
