---
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import QuizEngine from "../../components/QuizEngine.tsx";
import { loadRegionalCandidates, loadQuestions, loadConstituencies, loadRegions } from "../../lib/data";

const questions = loadQuestions();
const candidates = loadRegionalCandidates();
const constituencies = loadConstituencies();
const regions = loadRegions();
const base = import.meta.env.BASE_URL;
---

<Base title="Vote Compass — Regional List" description="Answer 8 questions and find which candidate aligns with your values for the regional list ballot">
  <Header slot="header" currentTab="regional" />
  <QuizEngine client:load mode="regional" questions={questions} candidates={candidates} regions={regions} constituencies={constituencies} knownConstituencies={constituencies.map((c) => c.id)} basePath={base} />
  <Footer slot="footer" />
</Base>
