{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["parties"],
  "properties": {
    "parties": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "manifestoUrls", "manifestoPdf", "parsedAt", "positionsFile"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "manifestoUrls": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "manifestoPdf": { "type": ["string", "null"] },
          "parsedAt": {
            "type": ["string", "null"],
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "positionsFile": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
